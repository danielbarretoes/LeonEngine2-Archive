// Application icon (Explorer / taskbar / Alt-Tab).
// Requires BMP/DIB .ico (not PNG-in-ICO) — regenerate with Scripts/make-editor-icon.py
// Numeric ID 1 is the Windows shell primary exe icon. GLFW_ICON is the class icon GLFW loads.
#define IDI_LEON_EDITOR 1
IDI_LEON_EDITOR ICON "@LEON_EDITOR_ICO@"
GLFW_ICON       ICON "@LEON_EDITOR_ICO@"
