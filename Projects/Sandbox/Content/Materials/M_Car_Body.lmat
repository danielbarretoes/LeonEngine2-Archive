# LeonEngine2 Material Asset File (.lmat)
# Painted body: no tiling plate maps. Car_Body is a long box; smart-project UV0
# stretches a 1:1 tile ~6:1 on the sides (extruded grooves + noisy specular).
Material:
  Type: "PBR_Lit"
  AlbedoColor: [0.62, 0.05, 0.04]
  Metallic: 0.45
  Roughness: 0.28
  AO: 1.0
  NormalScale: 1.0
  OcclusionStrength: 1.0
  UVTiling: [1.0, 1.0]
  UVOffset: [0.0, 0.0]
  UsePlanarReflection: true
