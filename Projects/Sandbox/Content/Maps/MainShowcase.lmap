# LeonEngine2 Map Asset File (.lmap)
# Unreal Engine-inspired structured level format
# 3x6 PBR Feature Matrix Showcase + Multi-Light Rig

Map:
  Name: "MainShowcase"
  Version: 1.0

Environment:
  Skybox:
    Enabled: true
    Exposure: 1.0
    SunIntensity: 3.5
    EnvironmentIntensity: 1.2
    HDREnvironmentMap: "Projects/Sandbox/Content/HDR/AutumnField1k.lhdr"
    UseHDREnvironmentMap: true
    SkyZenithColor: [0.18, 0.44, 0.88]
    HorizonColor: [0.78, 0.84, 0.95]
    GroundColor: [0.22, 0.24, 0.28]
    SunColor: [1.0, 0.98, 0.92]

Actors:
  # =========================================================================
  # Dynamic Lighting Rig (1 Directional + 2 Point Lights + 2 Spot Lights)
  # =========================================================================
  - Name: "Directional Sunlight"
    Transform:
      Translation: [0.0, 4.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    DirectionalLight:
      Enabled: true
      Direction: [-0.45, -1.0, -0.35]
      Color: [1.0, 0.98, 0.92]
      Intensity: 3.5

  - Name: "Orbiting Point Light"
    Transform:
      Translation: [3.5, 1.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.55, 0.15]
      Intensity: 5.0
      Radius: 12.0

  - Name: "Accent Magenta Point Light"
    Transform:
      Translation: [-3.5, 1.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [0.95, 0.15, 1.0]
      Intensity: 4.5
      Radius: 10.0

  - Name: "Dramatic Spotlight"
    Transform:
      Translation: [0.0, 4.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [0.0, -1.0, 0.0]
      Color: [0.0, 0.95, 1.0]
      Intensity: 50.0
      Radius: 20.0
      CutOff: 20.0
      OuterCutOff: 30.0

  - Name: "Golden Raking Spotlight"
    Transform:
      Translation: [-6.0, 3.8, 3.5]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [0.75, -0.45, -0.45]
      Color: [1.0, 0.85, 0.40]
      Intensity: 40.0
      Radius: 22.0
      CutOff: 18.0
      OuterCutOff: 28.0

  # =========================================================================
  # Stage Ground
  # =========================================================================
  - Name: "PBR Ground Plane"
    Transform:
      Translation: [0.0, 0.0, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Plane"
      Width: 28.0
      Depth: 24.0
      SubdivisionsX: 28
      SubdivisionsZ: 24
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: false
      ReceiveShadows: true
      VisibleInReflection: false
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_FloorTiles.lmat"

  # =========================================================================
  # ROW 1 (Front, Z = 2.0): Core PBR & Geometries
  # =========================================================================
  - Name: "PBR Emerald Ramp"
    Transform:
      Translation: [-5.0, 0.5, 2.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Ramp"
      Width: 1.0
      Height: 1.0
      Depth: 1.0
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_EmeraldRamp.lmat"

  - Name: "PBR Textured Cube"
