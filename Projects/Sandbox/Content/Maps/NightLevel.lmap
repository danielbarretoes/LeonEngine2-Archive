      Translation: [0, 20, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLight:
      Enabled: true
      Direction: [0.28, -0.9, -0.32]
      Color: [0.45, 0.58, 0.95]
      Intensity: 2.4
      Mobility: Static
  - Name: "Street Lamp Light A"
