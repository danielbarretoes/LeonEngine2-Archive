# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "NightLevel"
  Version: "2.0"

Environment:
  Skybox:
    Enabled: true
    Exposure: 0.75
    SunIntensity: 0.12
    EnvironmentIntensity: 0.28
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/NightSky1k.lhdr"
    SkyZenithColor: [0.02, 0.04, 0.1]
    HorizonColor: [0.08, 0.1, 0.18]
    GroundColor: [0.03, 0.03, 0.04]
    SunColor: [0.55, 0.65, 0.95]
    StaticLighting: true
    LightmapResolution: 64
    NumIndirectBounces: 2
    SamplesPerTexel: 8
    IndirectIntensity: 1
    AmbientOcclusion: false
    AOIntensity: 1
    AORadius: 0.4
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/NightLevel.llightmap"
    LightmapBakeHash: "797509a115f5cb1"

Actors:
  - Name: "Main Camera"
    Transform:
      Translation: [-6.2, 2.8, 12.5]
      Rotation: [-8, -22, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FOV: 50
      NearClip: 0.1
      FarClip: 1000
  - Name: "Moonlight"
