# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "NightLevel"
  Version: "2.0"

Environment:
  Skybox:
    Enabled: true
    Exposure: 0.9
    SunIntensity: 0.15
    EnvironmentIntensity: 0.32
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/NightField1k.lhdr"
    SkyZenithColor: [0.02, 0.04, 0.1]
    HorizonColor: [0.08, 0.1, 0.18]
    GroundColor: [0.03, 0.03, 0.04]
    SunColor: [0.55, 0.65, 0.95]
    StaticLighting: true
    LightmapResolution: 64
    NumIndirectBounces: 2
    SamplesPerTexel: 8
    IndirectIntensity: 1.15
    AmbientOcclusion: true
    AOIntensity: 1
    AORadius: 0.4
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/NightLevel.llightmap"
    LightmapBakeHash: "e72dff9e13b002fe"

Actors:
  - Name: "Main Camera"
    Transform:
      Translation: [-5.5, 2.6, 11]
      Rotation: [-10, -22, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FOV: 50
      NearClip: 0.1
      FarClip: 1000
  - Name: "Moonlight"
