# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "ShowcaseLevel"
  Version: "2.1"

Environment:
  WorldSettings:
    StaticLighting: true
    LightingBuildQuality: Draft
    LightmapResolution: 64
    NumIndirectBounces: 2
    SamplesPerTexel: 8
    IndirectIntensity: 1
    AmbientOcclusion: true
    AOIntensity: 1
    AORadius: 1
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/ShowcaseLevel.llightmap"
    LightmapBakeHash: "ce33386c59afd905"
  Skybox:
    Enabled: true
    Exposure: 0.9
    SunIntensity: 3.2
    EnvironmentIntensity: 1.05
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/DaySky1k.lhdr"
    SkyZenithColor: [0.18, 0.44, 0.88]
    HorizonColor: [0.78, 0.84, 0.95]
    GroundColor: [0.22, 0.24, 0.28]
    SunColor: [1, 0.98, 0.92]

Actors:
  - Name: "PlayerStart"
    Class: "APlayerStart"
    GUID: "4c454f4e00000000c0ffee0000000001"
    Transform:
      Translation: [0, 3.5, 10.5]
      Rotation: [0, -90, 0]
      Scale: [1, 1, 1]
  - Name: "Main Camera"
    Class: "AActor"
    GUID: "4c454f4eac22a5fcac22a5fce4481ebd"
    Transform:
      Translation: [0, 3.2, 9.5]
      Rotation: [-12, 0, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FOV: 55
      NearClip: 0.1
      FarClip: 1000
  - Name: "Directional Sunlight"
