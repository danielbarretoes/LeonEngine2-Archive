# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "ShowcaseLevel"
  Version: "2.0"

Environment:
  Skybox:
    Enabled: true
    Exposure: 0.9
    SunIntensity: 3.2
    EnvironmentIntensity: 1.05
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/DaySky1k.lhdr"
    SkyZenithColor: [0.18, 0.44, 0.88]
    HorizonColor: [0.78, 0.84, 0.95]
    GroundColor: [0.22, 0.24, 0.28]
    SunColor: [1, 0.98, 0.92]
    StaticLighting: true
    LightmapResolution: 64
    NumIndirectBounces: 2
    SamplesPerTexel: 8
    IndirectIntensity: 1
    AmbientOcclusion: false
    AOIntensity: 1
    AORadius: 0.35
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/ShowcaseLevel.llightmap"
    LightmapBakeHash: "6467857ce1d6786e"

Actors:
  - Name: "Main Camera"
    Transform:
      Translation: [0, 3.2, 9.5]
      Rotation: [-12, 0, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FOV: 55
      NearClip: 0.1
      FarClip: 1000
  - Name: "Directional Sunlight"
    Transform:
      Translation: [0, 4.5, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLight:
      Enabled: true
      Direction: [-0.45, -1, -0.35]
      Color: [1, 0.98, 0.92]
      Intensity: 3.5
      Mobility: Stationary
  - Name: "Orbiting Point Light"
    Transform:
      Translation: [3.5, 1.5, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLight:
      Enabled: true
      Color: [1, 0.55, 0.15]
      Intensity: 5
      Radius: 12
      Mobility: Movable
  - Name: "Accent Magenta Point Light"
    Transform:
      Translation: [-3.5, 1.5, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLight:
      Enabled: true
      Color: [0.95, 0.15, 1]
      Intensity: 4.5
      Radius: 10
      Mobility: Static
  - Name: "Dramatic Spotlight"
    Transform:
      Translation: [0, 4.5, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    SpotLight:
      Enabled: true
      Direction: [0, -1, 0]
      Color: [0, 0.95, 1]
      Intensity: 50
      Radius: 20
      CutOff: 20
      OuterCutOff: 30
      Mobility: Stationary
  - Name: "Golden Raking Spotlight"
