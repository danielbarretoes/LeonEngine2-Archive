      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Trunk.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Crown.lmat"
        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Coconuts.lmat"
        - Slot: 3
