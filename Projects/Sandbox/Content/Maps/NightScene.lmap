        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Coconuts.lmat"
        - Slot: 3
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Leaves.lmat"

  - Name: "Palm Tree Front Right"
    Transform:
