# LeonEngine2 Map Asset File (.lmap)
# Nocturnal suburban street — NightField HDR, moon + practical lights

Map:
  Name: "NightScene"
  Version: 2.1

Environment:
  Skybox:
    Enabled: true
    Exposure: 0.85
    SunIntensity: 0.2
    EnvironmentIntensity: 0.38
    HDREnvironmentMap: "Projects/Sandbox/Content/HDR/NightField1k.lhdr"
    UseHDREnvironmentMap: true
    SkyZenithColor: [0.02, 0.04, 0.10]
    HorizonColor: [0.08, 0.10, 0.18]
    GroundColor: [0.03, 0.03, 0.04]
    SunColor: [0.55, 0.65, 0.95]

Actors:
  # =========================================================================
  # Camera — low street view toward house + car
  # =========================================================================
  - Name: "Main Cinematic Camera"
    Transform:
      Translation: [-4.2, 2.4, 9.8]
      Rotation: [-8.0, -28.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    Camera:
      Primary: true
      ProjectionType: "Perspective"
      FOV: 48.0
      NearClip: 0.1
      FarClip: 1000.0

  # =========================================================================
  # Soft moonlight (cool, dim — HDR carries most ambient)
  # =========================================================================
  - Name: "Night Moonlight"
    Transform:
      Translation: [0.0, 18.0, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    DirectionalLight:
      Enabled: true
      Direction: [0.25, -0.92, -0.30]
      Color: [0.35, 0.48, 0.85]
      Intensity: 0.22

  # =========================================================================
  # Street lamps — fewer, sodium-warm, along curb
  # =========================================================================
  - Name: "Street Lamp Light Near"
    Transform:
      Translation: [-6.0, 3.7, 4.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.72, 0.35]
      Intensity: 4.2
      Radius: 11.0

  - Name: "Street Lamp Light Far"
    Transform:
      Translation: [5.8, 3.7, -1.5]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.72, 0.35]
      Intensity: 3.8
      Radius: 10.0

  # =========================================================================
  # House practicals — porch + warm window wash
  # =========================================================================
  - Name: "House Porch Lantern Light"
    Transform:
      Translation: [-0.4, 2.15, -4.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.78, 0.42]
      Intensity: 3.5
      Radius: 7.0

  - Name: "House Window Glow"
    Transform:
      Translation: [1.2, 2.6, -5.8]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.85, 0.55]
      Intensity: 2.8
      Radius: 6.5

  - Name: "House Facade Wash Spotlight"
    Transform:
      Translation: [0.2, 1.1, -2.8]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [0.05, 0.55, -0.83]
      Color: [1.0, 0.90, 0.70]
      Intensity: 14.0
      Radius: 12.0
      CutOff: 22.0
      OuterCutOff: 34.0

  # =========================================================================
  # Car headlights — main night drama along driveway
  # =========================================================================
  - Name: "Car Headlight Beam Left"
    Transform:
      Translation: [3.55, 0.62, 2.85]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [-0.55, -0.08, 0.83]
      Color: [1.0, 0.97, 0.90]
      Intensity: 48.0
      Radius: 24.0
      CutOff: 14.0
      OuterCutOff: 24.0

  - Name: "Car Headlight Beam Right"
    Transform:
      Translation: [4.45, 0.62, 2.35]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [-0.55, -0.08, 0.83]
      Color: [1.0, 0.97, 0.90]
      Intensity: 48.0
      Radius: 24.0
      CutOff: 14.0
      OuterCutOff: 24.0

  - Name: "Car Taillight Glow Left"
    Transform:
      Translation: [4.85, 0.58, 0.15]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.04, 0.04]
      Intensity: 2.2
      Radius: 3.2

  - Name: "Car Taillight Glow Right"
    Transform:
      Translation: [5.55, 0.58, -0.25]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.04, 0.04]
      Intensity: 2.2
      Radius: 3.2

  # =========================================================================
  # Soft garden uplight (subtle, not neon)
  # =========================================================================
  - Name: "Garden Palm Uplight"
    Transform:
      Translation: [-8.2, 0.15, -6.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [0.15, 0.95, -0.25]
      Color: [0.35, 0.75, 0.55]
      Intensity: 9.0
      Radius: 10.0
      CutOff: 18.0
      OuterCutOff: 30.0

  # =========================================================================
  # Ground
  # =========================================================================
  - Name: "Night Ground Plane"
    Transform:
      Translation: [0.0, 0.0, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Plane"
      Width: 42.0
      Depth: 38.0
      SubdivisionsX: 40
      SubdivisionsZ: 36
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: false
      ReceiveShadows: true
      VisibleInReflection: false
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_FloorTiles.lmat"

  # =========================================================================
  # House — set back as focal backdrop
  # =========================================================================
  - Name: "Suburban House"
    Transform:
      Translation: [0.0, 0.0, -7.2]
      Rotation: [0.0, 8.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/House.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_House_Stone.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_House_Walls.lmat"
        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_House_Roof.lmat"
        - Slot: 3
          Asset: "Projects/Sandbox/Content/Materials/M_House_Wood.lmat"
        - Slot: 4
          Asset: "Projects/Sandbox/Content/Materials/M_House_Windows.lmat"

  # =========================================================================
  # Car — angled on driveway, headlights toward camera street
  # =========================================================================
  - Name: "Sports Car"
    Transform:
      Translation: [4.2, 0.0, 1.5]
      Rotation: [0.0, -38.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/Car.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_Car_Body.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_Car_Windows.lmat"
        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_Car_Chrome.lmat"
        - Slot: 3
          Asset: "Projects/Sandbox/Content/Materials/M_Car_Headlights.lmat"
        - Slot: 4
          Asset: "Projects/Sandbox/Content/Materials/M_Car_Taillights.lmat"
        - Slot: 5
          Asset: "Projects/Sandbox/Content/Materials/M_Car_Tires.lmat"

  # =========================================================================
  # Street lamps (2 practical poles)
  # =========================================================================
  - Name: "Street Lamp Near"
    Transform:
      Translation: [-6.0, 0.0, 4.0]
      Rotation: [0.0, 55.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/StreetLamp.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_StreetLamp_Metal.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_StreetLamp_Glass.lmat"

  - Name: "Street Lamp Far"
    Transform:
      Translation: [5.8, 0.0, -1.5]
      Rotation: [0.0, -40.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/StreetLamp.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_StreetLamp_Metal.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_StreetLamp_Glass.lmat"

  # =========================================================================
  # Palms — frame the street / garden
  # =========================================================================
  - Name: "Palm Tree Street Left"
    Transform:
      Translation: [-8.0, 0.0, 6.0]
      Rotation: [0.0, 40.0, 0.0]
      Scale: [1.05, 1.05, 1.05]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/PalmTree.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Trunk.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Crown.lmat"
        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Coconuts.lmat"
        - Slot: 3
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Leaves.lmat"

  - Name: "Palm Tree Driveway"
    Transform:
      Translation: [7.8, 0.0, 4.5]
      Rotation: [0.0, -125.0, 0.0]
      Scale: [0.92, 0.92, 0.92]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/PalmTree.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Trunk.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Crown.lmat"
        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Coconuts.lmat"
        - Slot: 3
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Leaves.lmat"

  - Name: "Palm Tree Garden"
    Transform:
      Translation: [-8.0, 0.0, -7.5]
      Rotation: [0.0, 70.0, 0.0]
      Scale: [1.15, 1.15, 1.15]
    StaticMesh:
      Asset: "Projects/Sandbox/Content/Meshes/PalmTree.lmesh"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
      MaterialOverrides:
        - Slot: 0
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Trunk.lmat"
        - Slot: 1
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Crown.lmat"
        - Slot: 2
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Coconuts.lmat"
        - Slot: 3
          Asset: "Projects/Sandbox/Content/Materials/M_Palm_Leaves.lmat"

  # =========================================================================
  # Labels — quieter, off to the side
  # =========================================================================
  - Name: "Label Scene Title"
    Transform:
      Translation: [-6.5, 0.12, 8.2]
      Rotation: [-18.0, 20.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    Text:
      Content: "NIGHT STREET"
      Color: [0.75, 0.82, 1.0, 0.75]
      Scale: 0.16

  - Name: "Label Scene Subtitle"
    Transform:
      Translation: [-6.5, 0.12, 7.6]
      Rotation: [-18.0, 20.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    Text:
      Content: "NightField HDR · Moon · Practicals · Headlights"
      Color: [0.45, 0.70, 0.90, 0.65]
      Scale: 0.10
