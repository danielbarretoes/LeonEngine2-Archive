      Rotation: [-20.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    Text:
      Content: "NOCTURNAL SUBURBAN SHOWCASE"
      Color: [1.0, 0.88, 0.50, 0.95]
