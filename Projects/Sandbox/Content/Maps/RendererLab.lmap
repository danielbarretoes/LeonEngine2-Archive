# LeonEngine2 Map Asset File (.lmap)
# Diagnostic PBR lab — spawned extras come from ASandboxGameMode.
Map:
  Name: "RendererLab"
  Version: "2.1"

Environment:
  WorldSettings:
    StaticLighting: false
    LightingBuildQuality: Draft
    LightmapResolution: 64
    NumIndirectBounces: 0
    SamplesPerTexel: 4
    IndirectIntensity: 1
    AmbientOcclusion: false
    AOIntensity: 1
    AORadius: 0.35
    TexelPadding: 2
    WorldScale: 1
  Skybox:
    Enabled: true
    Exposure: 1.0
    SunIntensity: 3.0
    EnvironmentIntensity: 1.0
    UseHDREnvironmentMap: false
    SkyZenithColor: [0.18, 0.44, 0.88]
    HorizonColor: [0.78, 0.84, 0.95]
    GroundColor: [0.22, 0.24, 0.28]
    SunColor: [1, 0.98, 0.92]

Actors:
  - Name: "PlayerStart"
    Class: "APlayerStart"
    GUID: "4c454f4e00000000c0ffee00lab00001"
    Transform:
      Translation: [0, 2.5, 8]
      Rotation: [0, -90, 0]
      Scale: [1, 1, 1]
  - Name: "Lab Camera"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee00lab00002"
    Transform:
      Translation: [0, 2.2, 7]
      Rotation: [-8, 0, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FOV: 55
      NearClip: 0.1
      FarClip: 1000
  - Name: "Lab Sun"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee00lab00003"
    Transform:
      Translation: [0, 6, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLight:
      Enabled: true
      Direction: [-0.35, -1, -0.2]
      Color: [1, 0.98, 0.92]
      Intensity: 3.0
      Mobility: Movable
  - Name: "Lab Point"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee00lab00004"
    Transform:
      Translation: [2.5, 2.0, 1.0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    PointLight:
      Enabled: true
      Color: [1, 0.7, 0.4]
      Intensity: 8
      Radius: 12
      Mobility: Movable
  - Name: "Lab Spot"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee00lab00005"
    Transform:
      Translation: [-2.0, 4.0, 2.0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    SpotLight:
      Enabled: true
      Direction: [0.2, -1, -0.3]
      Color: [0.4, 0.8, 1]
      Intensity: 20
      Radius: 18
      CutOff: 16
      OuterCutOff: 24
      Mobility: Movable
  - Name: "Lab Ground"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee00lab00006"
    Transform:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    StaticMesh:
      Type: "Plane"
      Size: 1
      Width: 24
      Height: 1
      Depth: 16
      Radius: 0.5
      SubdivisionsX: 12
      SubdivisionsZ: 8
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: false
      ReceiveShadows: true
      VisibleInReflection: true
      Mobility: Movable
    Material:
      Asset: "/Game/Materials/M_StudioFloor.lmat"
