# LeonEngine2 Level Asset File (.llevel)
# Unreal Engine-inspired structured level format

Level:
  Name: "MainShowcase"
  Version: 1.0

Environment:
  Skybox:
    Enabled: true
    Exposure: 1.0
    SunIntensity: 3.5
    EnvironmentIntensity: 1.2
    HDREnvironmentMap: "Projects/Sandbox/Content/Assets/Hdr/AutumnField1k.hdr"
    UseHDREnvironmentMap: true
    SkyZenithColor: [0.18, 0.44, 0.88]
    HorizonColor: [0.78, 0.84, 0.95]
    GroundColor: [0.22, 0.24, 0.28]
    SunColor: [1.0, 0.98, 0.92]

Actors:
  # ==========================================
  # Light Actors
  # ==========================================
  - Name: "Directional Sunlight"
    Transform:
      Translation: [0.0, 3.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    DirectionalLight:
      Enabled: true
      Direction: [-0.45, -1.0, -0.35]
      Color: [1.0, 0.98, 0.92]
      AmbientIntensity: 0.10
      DiffuseIntensity: 3.5
      SpecularIntensity: 1.0

  - Name: "Orbiting Point Light"
    Transform:
      Translation: [3.2, 1.4, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    PointLight:
      Enabled: true
      Color: [1.0, 0.55, 0.15]
      Constant: 1.0
      Linear: 0.14
      Quadratic: 0.07
      AmbientIntensity: 0.05
      DiffuseIntensity: 4.0
      SpecularIntensity: 1.0

  - Name: "Dramatic Spotlight"
    Transform:
      Translation: [0.0, 4.2, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    SpotLight:
      Enabled: true
      Direction: [0.0, -1.0, 0.0]
      Color: [0.0, 0.95, 1.0]
      Intensity: 50.0
      Radius: 20.0
      CutOff: 20.0
      OuterCutOff: 30.0

  # ==========================================
  # Static Mesh Geometry & PBR Material Actors
  # ==========================================
  - Name: "PBR Ground Plane"
    Transform:
      Translation: [0.0, 0.0, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Plane"
      Width: 24.0
      Depth: 24.0
      SubdivisionsX: 24
      SubdivisionsZ: 24
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: false
      ReceiveShadows: true
      VisibleInReflection: false
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_FloorTiles.lmat"

  - Name: "PBR Emerald Ramp"
    Transform:
      Translation: [-4.0, 0.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Ramp"
      Width: 1.0
      Height: 1.0
      Depth: 1.0
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_EmeraldRamp.lmat"

  - Name: "PBR Textured Cube"
    Transform:
      Translation: [-2.4, 0.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Cube"
      Size: 1.0
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_ContainerCube.lmat"

  - Name: "PBR Polished Gold Sphere"
    Transform:
      Translation: [-0.8, 0.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Sphere"
      Radius: 0.5
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_PolishedGold.lmat"

  - Name: "PBR Glossy Ruby Sphere"
    Transform:
      Translation: [0.8, 0.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Sphere"
      Radius: 0.5
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_RubyDielectric.lmat"

  - Name: "PBR Brushed Iron Cylinder"
    Transform:
      Translation: [2.4, 0.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Cylinder"
      Radius: 0.5
      Height: 1.0
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_BrushedIron.lmat"

  - Name: "PBR Cobalt Pyramid"
    Transform:
      Translation: [4.0, 0.5, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Pyramid"
      Width: 1.0
      Height: 1.0
      Depth: 1.0
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_CobaltPyramid.lmat"

  # Phase 13 Showcase Actors
  - Name: "PBR White Plastic Sphere"
    Transform:
      Translation: [-3.2, 0.5, 2.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Sphere"
      Radius: 0.45
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_WhitePlastic.lmat"

  - Name: "PBR Red Plastic Cube"
    Transform:
      Translation: [-1.6, 0.5, 2.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Cube"
      Size: 0.9
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_RedPlastic.lmat"

  - Name: "PBR Gold Metal Cylinder"
    Transform:
      Translation: [0.0, 0.5, 2.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Cylinder"
      Radius: 0.45
      Height: 0.9
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_GoldMetal.lmat"

  - Name: "PBR Rough Metal Pyramid"
    Transform:
      Translation: [1.6, 0.5, 2.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Pyramid"
      Width: 0.9
      Height: 0.9
      Depth: 0.9
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_RoughMetal.lmat"

  - Name: "PBR Emissive Cyan Cube"
    Transform:
      Translation: [3.2, 0.5, 2.2]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    StaticMesh:
      Type: "Cube"
      Size: 0.9
      Shader: "Engine/Assets/Shaders/PBR_Lit.glsl"
      CastShadows: true
      ReceiveShadows: true
      VisibleInReflection: true
    Material:
      Asset: "Projects/Sandbox/Content/Materials/M_Emissive.lmat"

  # ==========================================
  # 3D In-World Text Actors
  # ==========================================
  - Name: "Text Actor - Scene Title"
    Transform:
      Translation: [0.0, 2.8, -1.8]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    Text:
      Content: "LEON ENGINE 2 - PHYSICAL PBR"
      Color: [0.72, 0.72, 0.72, 1.0]
      Size: 0.32
      Alignment: "Center"
      DoubleSided: true

  - Name: "Text Actor - Subtitle"
    Transform:
      Translation: [0.0, 2.35, -1.8]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
    Text:
      Content: "Cook-Torrance Specular | Atmospheric IBL | Dynamic Shadows | Tangent Normal Maps"
      Color: [0.72, 0.72, 0.72, 1.0]
      Size: 0.13
      Alignment: "Center"
      DoubleSided: true

  - Name: "Label - Emerald Ramp"
    Transform:
      Translation: [-4.0, 1.25, 0.0]
      Rotation: [0.0, 0.0, 0.0]
      Scale: [1.0, 1.0, 1.0]
