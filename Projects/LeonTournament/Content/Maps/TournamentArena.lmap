# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "MainMenu"
  Version: "2.1"

Environment:
  WorldSettings:
    StaticLighting: true
    LightingBuildQuality: Preview
    LightmapResolution: 48
    NumIndirectBounces: 1
    SamplesPerTexel: 4
    IndirectIntensity: 1.1
    AmbientOcclusion: true
    AOIntensity: 1
    AORadius: 1
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/TournamentArena.llightmap"
    LightmapBakeHash: "e5cb641ca80d84ad"
  Skybox:
    Enabled: true
    Exposure: 0.95
    SunIntensity: 2.2
    EnvironmentIntensity: 1.35
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/DaySky1k.lhdr"
    SkyZenithColor: [0.12, 0.28, 0.55]
    HorizonColor: [0.55, 0.62, 0.75]
    GroundColor: [0.18, 0.19, 0.22]
    SunColor: [1, 0.96, 0.88]

Actors:
  - Name: "PlayerStart"
    Class: "APlayerStart"
    GUID: "4c454f4e00000000c0ffee0000000101"
    Transform:
      Translation: [0, 3.5, 10.5]
      Rotation: [0, -90, 0]
      Scale: [1, 1, 1]
  - Name: "Directional Sunlight"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee0000000102"
    Transform:
      Translation: [0, 8, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLight:
      Enabled: true
      Direction: [-0.229658, -0.91863, -0.321521]
      Color: [1, 0.97, 0.9]
      Intensity: 2.4
      Mobility: Stationary
  - Name: "Bot_T1_4PC"
    Class: "ALeonTournamentBotController"
    GUID: "b3f6bd46d295a13f12b22bf436d15964"
