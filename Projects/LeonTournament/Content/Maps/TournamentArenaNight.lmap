# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "TournamentArenaNight"
  Version: "2.1"

Environment:
  WorldSettings:
    StaticLighting: true
    LightingBuildQuality: Preview
    LightmapResolution: 48
    NumIndirectBounces: 1
    SamplesPerTexel: 4
    IndirectIntensity: 1.15
    AmbientOcclusion: true
    AOIntensity: 1
    AORadius: 1
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/TournamentArenaNight.llightmap"
    LightmapBakeHash: "4f7788f0fdff6548"
  Skybox:
    Enabled: true
    Exposure: 0.88
    SunIntensity: 0.35
    EnvironmentIntensity: 0.95
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/NightSky1k.lhdr"
    SkyZenithColor: [0.02, 0.04, 0.1]
    HorizonColor: [0.08, 0.1, 0.18]
    GroundColor: [0.03, 0.03, 0.04]
    SunColor: [0.55, 0.65, 0.95]

