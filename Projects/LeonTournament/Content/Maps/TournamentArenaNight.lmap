      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    StaticMesh:
      Type: "Box"
      Size: 1
      Width: 64
      Height: 0.5
      Depth: 64
      Radius: 0.5
      MetersPerUv: 2
      SubdivisionsX: 24
