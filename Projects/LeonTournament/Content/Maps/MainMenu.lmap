# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "MainMenu"
  Version: "2.1"

Environment:
  WorldSettings:
    StaticLighting: false
    LightingBuildQuality: Preview
    LightmapResolution: 64
    NumIndirectBounces: 1
    SamplesPerTexel: 4
    IndirectIntensity: 1
    AmbientOcclusion: false
    AOIntensity: 1
    AORadius: 1
    TexelPadding: 2
    WorldScale: 1
  Skybox:
    Enabled: true
    Exposure: 0.85
    SunIntensity: 2.8
    EnvironmentIntensity: 0.9
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/DaySky1k.lhdr"
    SkyZenithColor: [0.12, 0.22, 0.45]
    HorizonColor: [0.55, 0.62, 0.75]
    GroundColor: [0.12, 0.13, 0.14]
    SunColor: [1, 0.96, 0.88]

Actors:
  - Name: "PlayerStart"
    Class: "APlayerStart"
    GUID: "4c454f4e00000000c0ffee0000000101"
    Transform:
      Translation: [0, 3.5, 10.5]
      Rotation: [0, -90, 0]
      Scale: [1, 1, 1]
  - Name: "Directional Sunlight"
    Class: "AActor"
    GUID: "4c454f4e00000000c0ffee0000000102"
    Transform:
      Translation: [0, 8, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    DirectionalLight:
      Enabled: true
      Direction: [-0.4, -1, -0.3]
      Color: [1, 0.98, 0.92]
      Intensity: 3.2
      Mobility: Static
