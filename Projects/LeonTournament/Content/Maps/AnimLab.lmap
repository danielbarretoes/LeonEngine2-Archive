# LeonEngine2 Map Asset File (.lmap)
# Human-Readable & Deterministic Serialization
Map:
  Name: "AnimLab"
  Version: "2.1"

Environment:
  WorldSettings:
    StaticLighting: true
    LightingBuildQuality: Draft
    LightmapResolution: 64
    NumIndirectBounces: 2
    SamplesPerTexel: 8
    IndirectIntensity: 1
    AmbientOcclusion: true
    AOIntensity: 1
    AORadius: 1
    TexelPadding: 2
    WorldScale: 1
    LightmapAsset: "/Game/Lightmaps/AnimLab.llightmap"
    LightmapBakeHash: "314cea821cf3d1f5"
  Skybox:
    Enabled: true
    Exposure: 0.85
    SunIntensity: 2.8
    EnvironmentIntensity: 0.9
    UseHDREnvironmentMap: true
    HDREnvironmentMap: "/Game/HDR/DaySky1k.lhdr"
    SkyZenithColor: [0.12, 0.22, 0.45]
    HorizonColor: [0.55, 0.62, 0.75]
    GroundColor: [0.12, 0.13, 0.14]
    SunColor: [1, 0.96, 0.88]

