  - Name: "PlayerStart"
    Class: "APlayerStart"
    GUID: "4c454f4e00000000c0ffee0000000201"
    PlayerStartTag: "Player"
    TeamIndex: 1
    Transform:
      Translation: [-4, 2, 0]
      Rotation: [0, 90, 0]
      Scale: [1, 1, 1]
